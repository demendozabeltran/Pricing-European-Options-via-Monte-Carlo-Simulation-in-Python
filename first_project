import math as m
import random

def greaterThanZero(val):
    if val > 0.0:
        return val
    return 0.0

def randomNumberGenerator():

    x = 0
    y = 0

    sq = 1.0

    while sq>=1.0:
        x = (2.0 * random.random())-1
        y = (2.0 * random.random())-1
        
        sq = x*x + y*y

    return x*m.sqrt(-2*m.log(sq)/sq)

def monte_carlo_call_price(price0, strike, time, rate, volatility, sims):
    payout = 0.0
    for i in range(sims):
    
        GBM = price0 * m.exp((rate - ((1/2)*(volatility**2)))*time+volatility*m.sqrt(time)*randomNumberGenerator())
        payout += greaterThanZero(GBM-strike)

    return m.exp(-rate * time) * (payout / sims)

def monte_carlo_put_price(price0, strike, time, rate, volatility, sims):
        payout = 0.0
        for i in range(sims):
            
            GBM = price0 * m.exp((rate - ((1/2)*(volatility**2)))*time+volatility*m.sqrt(time)*randomNumberGenerator())
            payout += greaterThanZero(strike-GBM)
        
        return m.exp(-rate * time) * (payout / sims)

sims = 1000000
strike = 100.0
price0 = 100.0
rate = 0.05
volatility = 0.2
time = 1.0

call = monte_carlo_call_price(price0, strike, time, rate, volatility, sims)
put = monte_carlo_put_price(price0, strike, time, rate, volatility, sims)

print("Call ", call)
print("Put ", put)
